<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.aquaguardian.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash" >
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.aquaguardian.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login_frament">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.aquaguardian.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_registerFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment" />
    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.aquaguardian.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_dashboardFragment_to_reportIssueFragment"
            app:destination="@id/reportIssueFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_issueListFragment"
            app:destination="@id/issueListFragment" />
    </fragment>

    <fragment
        android:id="@+id/reportIssueFragment"
        android:name="com.example.aquaguardian.ReportIssueFragment"
        android:label="Report Issue"
        tools:layout="@layout/fragment_report_issue">
        <action
            android:id="@+id/action_reportIssueFragment_to_updateSuccessFragment"
            app:destination="@id/updateSuccessFragment" />
    </fragment>

    <fragment
        android:id="@+id/issueListFragment"
        android:name="com.example.aquaguardian.IssueListFragment"
        android:label="Issues"
        tools:layout="@layout/fragment_issue_list">
        <action
            android:id="@+id/action_issueListFragment_to_issueDetailsFragment"
            app:destination="@id/issueDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/issueDetailsFragment"
        android:name="com.example.aquaguardian.IssueDetailsFragment"
        android:label="Details"
        tools:layout="@layout/fragment_issue_details">
        <action
            android:id="@+id/action_issueDetailsFragment_to_editIssueFragment"
            app:destination="@id/editIssueFragment" />
        <action
            android:id="@+id/action_issueDetailsFragment_to_deleteWarningFragment"
            app:destination="@id/deleteWarningFragment" />
    </fragment>

    <fragment
        android:id="@+id/editIssueFragment"
        android:name="com.example.aquaguardian.EditIssueFragment"
        android:label="Edit Issue"
        tools:layout="@layout/fragment_edit_issue">
        <action
            android:id="@+id/action_editIssueFragment_to_updateSuccessFragment"
            app:destination="@id/updateSuccessFragment" />
    </fragment>

    <fragment
        android:id="@+id/updateSuccessFragment"
        android:name="com.example.aquaguardian.UpdateSuccessFragment"
        android:label="Success"
        tools:layout="@layout/fragment_update_success">
        <action
            android:id="@+id/action_updateSuccessFragment_to_issueListFragment"
            app:destination="@id/issueListFragment" />
    </fragment>

    <fragment
        android:id="@+id/deleteWarningFragment"
        android:name="com.example.aquaguardian.DeleteWarningFragment"
        android:label="Delete Confirmation"
        tools:layout="@layout/fragment_delete_dialog">
        <action
            android:id="@+id/action_deleteWarningFragment_to_deleteSuccessFragment"
            app:destination="@id/deleteSuccessFragment" />
    </fragment>

    <fragment
        android:id="@+id/deleteSuccessFragment"
        android:name="com.example.aquaguardian.DeleteSuccessFragment"
        android:label="Deleted"
        tools:layout="@layout/fragment_delete_success">
        <action
            android:id="@+id/action_deleteSuccessFragment_to_issueListFragment"
            app:destination="@id/issueListFragment" />
    </fragment>
</navigation>