<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E6F4F8"
    android:padding="20dp">

    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Issue Details:" android:textSize="18sp" android:textStyle="bold" android:textColor="#0E4A6F"/>
        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_alignParentEnd="true" android:src="@drawable/aqua_logo"/>
    </RelativeLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:src="@drawable/sample_water_issue_large"
        android:scaleType="centerCrop"
        android:layout_marginVertical="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@drawable/bg_rounded_input"
        android:padding="20dp"
        android:textColor="#333333"
        android:textSize="13sp"
        android:text="Industrial waste has led to the presence of metals (especially heavy metals) in the water which poses a significant risk not only on human health, but also on animal health and agricultural production..."/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Current Status: Pending"
        android:textColor="#DC3545"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        android:layout_gravity="start"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <Button
            android:id="@+id/btnEdit"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:text="Edit"
            android:backgroundTint="#777777"
            android:textAllCaps="false"/>
        <Button
            android:id="@+id/btnDelete"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:text="Delete"
            android:backgroundTint="#DC3545"
            android:textAllCaps="false"/>
    </RelativeLayout>
</LinearLayout>