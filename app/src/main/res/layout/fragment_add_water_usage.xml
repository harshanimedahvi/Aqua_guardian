<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DBEEF4"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:src="@drawable/aqua_logo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivIllustration"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="44dp"
            android:src="@drawable/girl_drinking"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:layout_editor_absoluteX="238dp" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Add Water Usage"
            android:textColor="#2A2A2A"
            android:textSize="24sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivLogo" />

        <TextView
            android:id="@+id/tvDateLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Date :"
            android:textColor="#1A1A1A"
            android:textSize="19sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

        <EditText
            android:id="@+id/etDate"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_field"
            android:hint="DD /MM / YYYY"
            android:textColorHint="#BFBFBF"
            android:gravity="center"
            android:inputType="date"
            android:paddingHorizontal="16dp"
            android:textColor="#1A1A1A"
            app:layout_constraintTop_toBottomOf="@+id/tvDateLabel" />

        <TextView
            android:id="@+id/tvWaterUsedLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Water Used:"
            android:textColor="#1A1A1A"
            android:textSize="19sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/etDate" />

        <EditText
            android:id="@+id/etWaterUsed"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_field"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:textColor="#1A1A1A"
            app:layout_constraintTop_toBottomOf="@+id/tvWaterUsedLabel" />

        <TextView
            android:id="@+id/tvPurposeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Purpose :"
            android:textColor="#1A1A1A"
            android:textSize="19sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/etWaterUsed" />

        <EditText
            android:id="@+id/etPurpose"
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_field"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:padding="16dp"
            android:textColor="#1A1A1A"
            app:layout_constraintTop_toBottomOf="@+id/tvPurposeLabel" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSave"
            android:layout_width="180dp"
            android:layout_height="55dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_custom_button"
            android:text="Save"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/etPurpose" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnViewHistory"
            android:layout_width="180dp"
            android:layout_height="65dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_custom_button"
            android:text="View Usage \nHistory"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnSave" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>