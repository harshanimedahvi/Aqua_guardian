<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D6EFF8">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomWaveContainer">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="32dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/new_backarrow"
                app:tint="#0F1E80"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/aqua_logo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/circleGreen"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/circle_green"
                app:layout_constraintEnd_toStartOf="@+id/circleYellow"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imgLogo" />

            <LinearLayout
                android:id="@+id/boxGreen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="6dp"
                android:background="#9AD1EC"
                android:orientation="vertical"
                android:padding="12dp"
                android:minHeight="260dp"
                app:layout_constraintEnd_toStartOf="@+id/boxYellow"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/circleGreen">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Water is clean and meets safety standards. It is safe for drinking, cooking, bathing, and washing. No special treatment is needed."
                    android:textColor="#1A1A1A"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.1"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/iconGreen"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/green_safe"
                app:layout_constraintEnd_toEndOf="@+id/boxGreen"
                app:layout_constraintStart_toStartOf="@+id/boxGreen"
                app:layout_constraintTop_toBottomOf="@+id/boxGreen" />


            <View
                android:id="@+id/circleYellow"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:background="@drawable/circle_yellow"
                app:layout_constraintEnd_toStartOf="@+id/circleRed"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/circleGreen"
                app:layout_constraintTop_toTopOf="@+id/circleGreen" />

            <LinearLayout
                android:id="@+id/boxYellow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="#9AD1EC"
                android:orientation="vertical"
                android:padding="12dp"
                android:minHeight="260dp"
                app:layout_constraintEnd_toStartOf="@+id/boxRed"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/boxGreen"
                app:layout_constraintTop_toTopOf="@+id/boxGreen">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Water may have minor contamination or quality issues. It is not fully safe for drinking unless treated. Boiling, filtering, or chlorination is recommended before use."
                    android:textColor="#1A1A1A"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.1"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/iconYellow"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/last_warning"
                app:layout_constraintEnd_toEndOf="@+id/boxYellow"
                app:layout_constraintStart_toStartOf="@+id/boxYellow"
                app:layout_constraintTop_toTopOf="@+id/iconGreen" />


            <View
                android:id="@+id/circleRed"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:background="@drawable/circle_red"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/circleYellow"
                app:layout_constraintTop_toTopOf="@+id/circleYellow" />

            <LinearLayout
                android:id="@+id/boxRed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="12dp"
                android:background="#9AD1EC"
                android:orientation="vertical"
                android:padding="12dp"
                android:minHeight="260dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/boxYellow"
                app:layout_constraintTop_toTopOf="@+id/boxYellow">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Water is heavily contaminated and poses serious health risks. Do not drink, cook, or bathe with this water. Use only approved emergency or alternative water sources."
                    android:textColor="#1A1A1A"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.1"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/iconRed"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/danger_red"
                app:layout_constraintEnd_toEndOf="@+id/boxRed"
                app:layout_constraintStart_toStartOf="@+id/boxRed"
                app:layout_constraintTop_toTopOf="@+id/iconYellow" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomWaveContainer"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/imgWave"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/water_wave"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/btnCheckUsage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#81C784"
            android:text="Check About Water Usage"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            app:cornerRadius="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>