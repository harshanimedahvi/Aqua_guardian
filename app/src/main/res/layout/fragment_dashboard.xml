<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Dashboard:"
            android:textStyle="bold"
            android:textSize="25sp"/>
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/aqua_logo_small"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_nav"
        android:layout_below="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:scaleType="centerCrop"
                android:src="@drawable/img_8"
                android:layout_marginBottom="20dp"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2">

                <LinearLayout
                    android:id="@+id/btnReportIssue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/img_7"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Report Your Issues" android:textSize="12sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnWaterQuality"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/img_10"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Water Quality Records" android:textSize="12sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnWaterUsage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_trading"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Water Usage Records" android:textSize="12sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnProfile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_profile"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="User Profile &amp; Settings" android:textSize="12sp" android:textStyle="bold"/>
                </LinearLayout>
            </GridLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white" />
</RelativeLayout>
